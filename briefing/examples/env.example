# Daily Briefing reads this file from your workspace. Never commit or share it.

# The search model for news (default profile "balanced": Gemini, with Claude as backup)
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
# console.anthropic.com -> API keys (backup, or the "anthropic" profile)
ANTHROPIC_API_KEY=

# Model profile: balanced | anthropic | lmstudio   (email always uses a local model)
BRIEFING_MODELS=balanced
# Monthly cap on model spend in US dollars (news only; the local model is free).
# Two briefs a day with 3-4 topics cost about $6-11 a month.
BRIEFING_MONTHLY_BUDGET_USD=10

# Phone delivery (all optional and free)
# Telegram: message @BotFather -> /newbot -> paste the token, then run `briefing telegram-link`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy: install the ntfy app, subscribe to a long random topic name, put it here
NTFY_TOPIC=
# WhatsApp via CallMeBot (personal use): https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# IMAP app passwords, under the names you chose in settings.yaml (password_env)
# WORK_MAIL_PASSWORD=
